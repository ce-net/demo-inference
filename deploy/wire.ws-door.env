# ~/.config/ce-door/env/wire.ws-door.env on the door node, then `ce-door restart wire.ws-door`.
# The public listener binds loopback only; a tunnel publishes it. WIRE_WS_PUBLIC_AT: the other holders' node ids
# (16 hex, as the page names them in ?at=); each device's own ce-cap gate still decides every op.
WIRE_WS_PUBLIC_ADDR=127.0.0.1:7797
WIRE_WS_PUBLIC_APIS=infer.generate,place.near,net.rtt,client.gen
WIRE_WS_PUBLIC_AT=<node id of each other device, comma separated>
